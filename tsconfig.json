{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "NodeNext",
    "baseUrl": ".",
    "rootDir": ".",
    // 是否跳过对所有外部库（包括默认库和自定义库）的类型检查
    "skipLibCheck": true,
    // 模块解析策略
    "moduleResolution": "nodenext",
    // 是否解析 package.json 文件中的 "imports"字段来确定模块的入口点
    "resolvePackageJsonImports": true,
    // 用于实现与 CommonJS 和 AMD 等旧的模块系统的互操作性
    "esModuleInterop": true,
    // 检查代码中是否存在未使用的局部变量。
    "noUnusedLocals": true,
    // 检查在switch语句中是否存在没有break或return等终止语句导致的“穿透”情况
    "noFallthroughCasesInSwitch": true,
    "paths": {}
  },
  "include": [
    "src",
  ],
  "exclude": [
    "node_modules"
  ],
  "ts-node": {
    "esm": true
  }
}